# Direwolf portrait models. Two meshes share one UV layout and one texture set:
#   direwolf_pup.mesh   - pup model, used by the pup (0.60) and juvenile (0.90) stages
#   direwolf_adult.mesh - adult model, used by the subadult (1.20) and adult (1.35) stages
# Both are exported with the eyes 86.6 units up at scale 1.0 (the old model's eye height), so
# the stage scales keep the old size progression. The skeletons differ (rest pose, and the
# adult has *_end leaf bones), so each model has its own animation files; every growth stage gets
# its own set (same ids, same files) whose reference_skeleton is that stage's own mesh: the engine
# retargets a set onto each mesh relative to its reference INCLUDING pdxmesh scale, so a stage
# importing another stage's set gets its bone offsets stretched/squashed by the scale ratio.
# Submeshes of node direwolf_model: 0 head, 1 body, 2 fur cards, 3 mouth/teeth, 4 eye lenses.

skeletal_animation_set = {
	name = "direwolf_pup_animations"
	reference_skeleton = "direwolf_mesh_pup_natural"

	animation = { id = "direwolf_idle"		type = "direwolf_pup_idle.anim" }
	animation = { id = "direwolf_howl"		type = "direwolf_pup_howl.anim" }
	animation = { id = "direwolf_walk"		type = "direwolf_pup_walk.anim" }
	animation = { id = "direwolf_trot"		type = "direwolf_pup_trot.anim" }
	animation = { id = "direwolf_sniff"		type = "direwolf_pup_sniff.anim" }
	animation = { id = "direwolf_sit"		type = "direwolf_pup_sit.anim" }
	animation = { id = "direwolf_idle_restless"		type = "direwolf_pup_idle_restless.anim" }
	animation = { id = "direwolf_idle_territorial"		type = "direwolf_pup_idle_territorial.anim" }
	animation = { id = "direwolf_idle_shift"		type = "direwolf_pup_idle_shift.anim" }
	animation = { id = "direwolf_idle_sniff"		type = "direwolf_pup_idle_sniff.anim" }
	animation = { id = "direwolf_idle_sit"		type = "direwolf_pup_idle_sit.anim" }
}

