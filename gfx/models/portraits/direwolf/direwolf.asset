pdxmesh = {
	name = "direwolf_mesh_pup_albino"
	file = "direwolf_pup.mesh"
	scale = 0.60

	import = { type = skeletal_animation_set  name = "direwolf_pup_animations" }

	meshsettings = {
		name = "direwolf_model"
		index = 0
		texture_diffuse = "direwolf_wolf_head_albino_diffuse.dds"
		texture_normal = "direwolf_wolf_head_normal.dds"
		texture_specular = "direwolf_wolf_head_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	meshsettings = {
		name = "direwolf_model"
		index = 1
		texture_diffuse = "direwolf_wolf_body_albino_diffuse.dds"
		texture_normal = "direwolf_wolf_body_normal.dds"
		texture_specular = "direwolf_wolf_body_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	meshsettings = {
		name = "direwolf_model"
		index = 2
		texture_diffuse = "direwolf_wolf_fur_albino_diffuse.dds"
		texture_normal = "direwolf_wolf_flat_normal.dds"
		texture_specular = "direwolf_wolf_fur_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
		rasterizerstate = "rasterizer_no_culling"
		additional_shader_defines = {
			"DOUBLE_SIDED_ENABLED"
		}
	}
	meshsettings = {
		name = "direwolf_model"
		index = 3
		texture_diffuse = "direwolf_wolf_mouth_diffuse.dds"
		texture_normal = "direwolf_wolf_mouth_normal.dds"
		texture_specular = "direwolf_wolf_mouth_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	meshsettings = {
		name = "direwolf_model"
		index = 4
		texture_diffuse = "direwolf_wolf_eye_red_diffuse.dds"
		texture_normal = "direwolf_wolf_flat_normal.dds"
		texture_specular = "direwolf_wolf_eye_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}
