entity = {
	name = "direwolf_pup_albino_entity"
	pdxmesh = "direwolf_mesh_pup_albino"

	get_state_from_parent = yes
	default_state = "direwolf_idle"

	state = { name = "direwolf_idle"	animation = "direwolf_idle"	looping = yes	animation_speed = 0.6 }
	state = { name = "direwolf_howl"	animation = "direwolf_howl"	looping = yes	animation_speed = 1.2 }
	state = { name = "direwolf_walk"	animation = "direwolf_walk"	looping = yes	animation_speed = 1.2 }
}
