skeletal_animation_set = {
	name = "direwolf_animations"
	reference_skeleton = "direwolf_mesh_adult_natural"

	animation = { id = "direwolf_idle"		type = "direwolf_idle.anim" }
	animation = { id = "direwolf_howl"		type = "direwolf_howl.anim" }
	animation = { id = "direwolf_walk"		type = "direwolf_walk.anim" }
}

pdxmesh = {
	name = "direwolf_mesh_pup_albino"
	file = "direwolf.mesh"
	scale = 0.60

	import = { type = skeletal_animation_set  name = "direwolf_animations" }

	meshsettings = {
		name = "direwolf_body"
		index = 0
		texture_diffuse = "direwolf_body_albino_diffuse.dds"
		texture_normal = "direwolf_body_normal.dds"
		texture_specular = "direwolf_body_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}
