# direwolf_idle is a roster of clips that all start and end in the alert pose; a new one is rolled
# each time one ends. The FIRST pick is not random in the engine, so every break clip opens with 5 s
# of the alert idle - whatever is picked first, the wolf starts standing alert.
# The alert state is listed LAST so its slice of the roll is the top 60-99 - where the fixed first
# roll has been landing (it picked sniff, slice 70-90, when alert was listed first).
# Chance = relative weight:
#   alert 15 s (39) | 5 s alert + restless shift 5 s (24) | 5 s alert + sniff 9 s (24) | 5 s alert + sit 18.4 s (12)
# -> on average a restless shift and a sniff about once a minute each, a sit break about every
# 2 minutes (sit down, 15 s seated idle, stand up; ~13% of the time seated). Every other state is a
# plain loop. direwolf_howl is a seated howl followed by 5 s of the seated idle, so the loop has a
# breath between howls; direwolf_sit is the 15 s seated idle.
entity = {
	name = "direwolf_pup_albino_entity"
	pdxmesh = "direwolf_mesh_pup_albino"

	get_state_from_parent = yes
	default_state = "direwolf_idle"

	state = { name = "direwolf_idle"	animation = "direwolf_idle_shift"	chance = 24	looping = no	next_state = "direwolf_idle"	animation_blend_time = 0.3 }
	state = { name = "direwolf_idle"	animation = "direwolf_idle_sniff"	chance = 24	looping = no	next_state = "direwolf_idle"	animation_blend_time = 0.3 }
	state = { name = "direwolf_idle"	animation = "direwolf_idle_sit"	chance = 12	looping = no	next_state = "direwolf_idle"	animation_blend_time = 0.3 }
	state = { name = "direwolf_idle"	animation = "direwolf_idle"	chance = 39	looping = no	next_state = "direwolf_idle"	animation_blend_time = 0.3 }
	state = { name = "direwolf_howl"		animation = "direwolf_howl"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_walk"		animation = "direwolf_walk"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_trot"		animation = "direwolf_trot"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_sniff"		animation = "direwolf_sniff"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_sit"		animation = "direwolf_sit"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_idle_restless"		animation = "direwolf_idle_restless"		looping = yes	animation_blend_time = 0.3 }
	state = { name = "direwolf_idle_territorial"	animation = "direwolf_idle_territorial"	looping = yes	animation_blend_time = 0.3 }
}
