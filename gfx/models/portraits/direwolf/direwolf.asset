
skeletal_animation_set = {
	name = "direwolf_animations"
	reference_skeleton = "direwolf_mesh_adult_natural"

	animation = { id = "direwolf_idle"		type = "direwolf_adult_idle.anim" }
	animation = { id = "direwolf_howl"		type = "direwolf_adult_howl.anim" }
	animation = { id = "direwolf_walk"		type = "direwolf_adult_walk.anim" }
	animation = { id = "direwolf_trot"		type = "direwolf_adult_trot.anim" }
	animation = { id = "direwolf_sniff"		type = "direwolf_adult_sniff.anim" }
	animation = { id = "direwolf_sit"		type = "direwolf_adult_sit.anim" }
	animation = { id = "direwolf_idle_restless"		type = "direwolf_adult_idle_restless.anim" }
	animation = { id = "direwolf_idle_territorial"		type = "direwolf_adult_idle_territorial.anim" }
	animation = { id = "direwolf_idle_sniff"		type = "direwolf_adult_idle_sniff.anim" }
	animation = { id = "direwolf_idle_sit"		type = "direwolf_adult_idle_sit.anim" }
}

