types DirewolfTreeView
{
	type dw_direwolf_tree_item = container {
		name = "dw_direwolf_tree_item"
		ignoreinvisible = yes

		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 14 0 }

			container = {
				parentanchor = hcenter
				ignoreinvisible = yes

				block "line_to_parent" {
					line = {
						using = Line_DynastyTree
						parentanchor = hcenter
						from = { 0 -10 }
						to = { 0 14 }
					}
				}

				flowcontainer = {
					direction = vertical
					parentanchor = hcenter
					ignoreinvisible = yes
					datacontext = "[Scope.GetCharacter]"

					button = {
						size = { 100 120 }
						parentanchor = hcenter
						onclick = "[DefaultOnCharacterClick( Character.GetID )]"
						using = tooltip_ne

						tooltipwidget = {
							container_character_tooltip = {}
						}

						portrait_head_small = {
							datacontext = "[Character]"
							parentanchor = hcenter
						}
					}

					text_single = {
						parentanchor = hcenter
						autoresize = no
						size = { 150 24 }
						elide = right
						align = center
						max_width = 150
						raw_text = "[Character.GetFirstNameNicknamedNoTooltip|V]"
						default_format = "#credits_subheader"
						tooltip = "[Character.GetFirstNameNicknamedNoTooltip|V]"
					}
				}
			}

			flowcontainer = {
				direction = vertical
				parentanchor = hcenter
				ignoreinvisible = yes
				datacontext = "[Scope.GetCharacter]"
				visible = "[GetScriptedGui('dw_direwolf_tree_has_children').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"

				widget = {
					parentanchor = hcenter

					line = {
						resizeparent = yes
						using = Line_DynastyTree
						from = { 0 0 }
						to = { 0 34 }
					}
				}

				widget = {
					parentanchor = hcenter
					size = { 94% 4 }

					background = {
						position = { 0 34 }
						texture = "gfx/lines/line_diffuse_07.dds"
						color = { 0.86 0.87 0.87 1 }
					}
				}

				container = {
					parentanchor = hcenter

					dynamicgridbox = {
						datamodel = "[GetGlobalVariable('dw_tree_being_shown').GetList('parent_story_container')]"

						item = {
							dynamicgridbox = {
								visible = "[ObjectsEqual(Scope.Var('this_parent').Char, Character.Self)]"
								datamodel = "[Scope.GetList('child_container')]"
								flipdirection = yes

								item = {
									recursive = yes
									dw_direwolf_tree_item = {}
								}
							}
						}
					}
				}
			}
		}
	}

	type dw_direwolf_tree_root_item = dw_direwolf_tree_item {
		blockoverride "line_to_parent" {}
	}
}

window = {
	name = "dw_direwolf_tree"
	parentanchor = center
	spriteType = Corneredtiled
	size = { 102% 102% }
	movable = no
	layer = middle
	using = Window_Background_Dragon_Tree
	datacontext = "[GetVariableSystem]"
	visible = "[And(And(GetVariableSystem.Exists('dw_direwolf_tree_visible'), IsInGame), GetGlobalVariable('dw_tree_being_shown').IsSet)]"

	state = {
		name = _show
		alpha = 1
	}

	state = {
		name = _hide
		on_finish = "[GetVariableSystem.Clear('dw_direwolf_tree_visible')]"
	}

	state = {
		name = dismiss
		next = _hide
		trigger_when = "[Not(GetVariableSystem.Exists('dw_direwolf_tree_visible'))]"
		on_finish = "[GetScriptedGui('dw_close_direwolf_tree').Execute( GuiScope.SetRoot( GetGlobalVariable('dw_tree_being_shown').Var('dw_tree_founder').Char.MakeScope ).End )]"
	}

	widget = {
		size = { 100% 100% }

		vbox = {
			margin = { 10 10 }

			zoomarea = {
				name = "dw_direwolf_tree_zoom_area"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				scissor = yes
				zoom = 0.8
				zoom_step = 0.2
				zoom_min = 0.2
				zoom_max = 1.0
				pan_position = { 0 0 }
				draggable_by = left|middle

				state = {
					name = "_zoom_changed"
					duration = 0.1
				}

				zoomwidget = {
					widget = {
						flowcontainer = {
							alwaystransparent = no
							direction = vertical
							resizeparent = yes
							ignoreinvisible = yes

							dynamicgridbox = {
								datamodel = "[GetGlobalVariable('dw_tree_being_shown').GetList('dw_tree_gui')]"

								item = {
									dw_direwolf_tree_root_item = {}
								}
							}
						}
					}
				}
			}
		}
	}

	widget = {
		size = { 385 130 }
		parentanchor = top|right
		widgetanchor = top|right
		position = { -33 20 }

		vbox = {
			margin = { 10 5 }
			margin_left = 20
			margin_bottom = 15

			background = {
				using = Background_Area_Dark
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 2

				vbox = {
					layoutpolicy_vertical = expanding
					margin_top = 7

					expand = {}
					text_multi = {
						autoresize = yes
						text = "DW_DIREWOLF_TREE_TITLE"
						default_format = "#credits_header"
					}
					expand = {}
				}

				expand = {}

				vbox = {
					layoutpolicy_vertical = expanding
					margin_top = 7

					text_single = {
						name = "dw_tree_total_members"
						text = "DW_DIREWOLF_TREE_MEMBERS"
						align = nobaseline
					}
					text_single = {
						name = "dw_tree_total_living"
						text = "DW_DIREWOLF_TREE_LIVING"
						align = nobaseline
					}
					expand = {}
				}

				vbox = {
					layoutpolicy_vertical = expanding

					button_close = {
						parentanchor = top|right
						tooltip = "CLOSE_TOOLTIP"
						onclick = "[GetVariableSystem.Clear('dw_direwolf_tree_visible')]"
						clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_close"
						using = Animation_ShowHide_Standard
					}
					expand = {}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 5
				spacing = 5

				text_single = {
					text = "DYNASTY_VIEW_CLICK_TO_PAN"
					autoresize = yes
					max_width = 470
					fontsize_min = 13
				}
				expand = {}
			}
		}
	}
}
